# Render Environment Variables
# Copy and paste this into Render's "Add from .env" dialog

# Python Settings
PYTHONUNBUFFERED=1

# Server Settings
PORT=10000
ENVIRONMENT=production

# Security Keys (Let Render generate these - leave as placeholders)
SECRET_KEY=GENERATE_ME
JWT_SECRET_KEY=GENERATE_ME
WEBHOOK_SECRET_TOKEN=GENERATE_ME

# Broker API Keys (Add your actual keys here)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# AI Services
OPENAI_API_KEY=your_openai_api_key_here

# Social Media
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=1407369896089616635
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database (if needed later)
DATABASE_URL=

# Other Services (optional)
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=

# Market Data Providers (optional)
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
IEX_CLOUD_API_KEY=

# Crypto APIs (optional)
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=
ETHERSCAN_API_KEY=

# News APIs (optional)
NEWS_API_KEY=
BENZINGA_API_KEY=

# Backup Services (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GOOGLE_DRIVE_API_KEY=
ONEDRIVE_CLIENT_ID=
