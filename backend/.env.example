# AuraQuant Backend Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB Atlas Connection
# Get your connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=auraquant

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Configuration
API_PORT=8000
NODE_ENV=development

# Memory Path (for local file storage)
MEMORY_PATH=D:\New AuraQuant\New_Synthetic_System_AuraQuant_Backup_2025\backend\Memory

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:5500

# Admin User (for initial setup)
ADMIN_EMAIL=wayneroberts32@outlook.com.au
ADMIN_PASSWORD=admin123

# Trading Configuration
STRATEGY_CONFIDENCE_MIN=0.6
MAX_POSITION_SIZE=10000
RISK_TOLERANCE=0.05

# Dashboard Path (for scanner)
DASHBOARD_PATH=D:\New AuraQuant\New_Synthetic_System_AuraQuant_Backup_2025\frontend\pages\main-trading-dashboard.html