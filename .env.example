# QUANTUM-READY TRADING SYSTEM CONFIGURATION
# Copy this file to .env and fill in your values

# ====================
# DEPLOYMENT
# ====================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ====================
# CLOUD PROVIDERS
# ====================
# Render Configuration
RENDER_URL=https://your-app.onrender.com
RENDER_API_KEY=your_render_api_key

# Cloudflare Configuration
CLOUDFLARE_URL=https://your-app.pages.dev
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_account_id

# ====================
# MARKET DATA SOURCES
# ====================
# Primary Market Data (Binance example)
MARKET_DATA_URL=wss://stream.binance.com:9443/ws
BINANCE_API_KEY=t2IeL6n2H05aSYJiCizIoReqlQU9cThwltCSvTpBfchWGUo79dK5LJtJhbbfQa70
BINANCE_API_SECRET=your_binance_api_secret

# Options Data
OPTIONS_DATA_URL=wss://options.deribit.com/ws/api/v2
OPTIONS_API_KEY=your_options_api_key

# Sentiment Data
SENTIMENT_URL=wss://sentiment.example.com/ws
SENTIMENT_API_KEY=uMsThZIQzn08Nnveyilham0qJYGIZwCTs89SvRF8yce12gUmDsS1bQRwLvYrfhys

# Alternative Data Sources
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
POLYGON_API_KEY=your_polygon_key

# ====================
# TRADING EXECUTION
# ====================
# Broker API Configuration
BROKER_API_URL=https://api.broker.com
BROKER_API_KEY=eef8c549-1a9b-4dda-92bf-2d18293b9cf3
BROKER_API_SECRET=9ac825d7420b40529a2e0dfadfe66ff2
BROKER_ACCOUNT_ID=your_account_id

# ====================
# DATABASE
# ====================
DATABASE_URL=postgresql://user:password@host:5432/quantum_trading
REDIS_URL=redis://localhost:6379

# ====================
# MONITORING & ALERTS
# ====================
# Datadog or similar
MONITORING_API_KEY=your_monitoring_key
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERT_EMAIL=alerts@yourdomain.com

# ====================
# SECURITY
# ====================
JWT_SECRET=your_very_long_random_string_here
ENCRYPTION_KEY=your_32_byte_encryption_key_here
API_RATE_LIMIT=100
SESSION_SECRET=your_session_secret_here

# ====================
# QUANTUM CONFIGURATION
# ====================
QUANTUM_COHERENCE_THRESHOLD=0.95
QUANTUM_ENTANGLEMENT_PAIRS=10
QUANTUM_SUPERPOSITION_ENABLED=true

# ====================
# RISK MANAGEMENT
# ====================
MAX_DRAWDOWN=0.10
POSITION_LIMIT=0.25
VAR_LIMIT=0.05
CORRELATION_LIMIT=0.70
EMERGENCY_SHUTDOWN_TRIGGER=-0.15

# ====================
# COGNITIVE COMPONENTS
# ====================
# Neuromorphic Core
NEUROMORPHIC_NEURONS=10000
NEUROMORPHIC_SPIKE_THRESHOLD=30
NEUROMORPHIC_LEARNING_RATE=0.01

# Topological Data Engine
TDA_DIMENSIONS=12
TDA_MAX_RADIUS=10
TDA_RESOLUTION=100

# Active Inference Core
ACTIVE_INFERENCE_LEVELS=5
ACTIVE_INFERENCE_ITERATIONS=100
ACTIVE_INFERENCE_LEARNING_RATE=0.01

# ====================
# LOGGING
# ====================
LOG_LEVEL=info
LOG_FILE=/var/log/quantum-trading.log
LOG_MAX_SIZE=10M
LOG_MAX_FILES=10

# ====================
# PERFORMANCE
# ====================
WORKER_THREADS=4
MAX_MEMORY_GB=8
CACHE_TTL=300
BATCH_SIZE=10

# ====================
# FEATURE FLAGS
# ====================
ENABLE_PAPER_TRADING=false
ENABLE_BACKTESTING=true
ENABLE_STRESS_TESTING=true
ENABLE_AUTO_TRADING=false
ENABLE_QUANTUM_MODE=true
ENABLE_DEBUG_MODE=false